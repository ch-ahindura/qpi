{
  "schema_version": 1,
  "operations": [
    {
      "name": "process",
      "summary": "Run quantum jobs pushed by QPI-UI and report their results.",
      "default_device": "mock",
      "events": [
        "JobDispatch",
        "JobResult"
      ],
      "devices": [
        {
          "name": "mock",
          "summary": "Qiskit BasicSimulator \u2014 the default, needs no hardware.",
          "extra": "",
          "options": [
            {
              "key": "data_dir",
              "help": "Directory the executor writes datasets and artefacts to.",
              "type": "safe_dir",
              "default": "./bin/data",
              "required": false,
              "example": "./bin/data"
            },
            {
              "key": "job_timeout",
              "help": "Seconds a single job may run before it is abandoned.",
              "type": "int",
              "default": "10",
              "required": false,
              "example": "30"
            },
            {
              "key": "is_dummy",
              "help": "Run against the vendor's dummy instruments instead of real hardware.",
              "type": "bool",
              "default": "false",
              "required": false,
              "example": "true"
            },
            {
              "key": "quantify_hardware_config",
              "help": "Path to the quantify hardware configuration JSON.",
              "type": "Path",
              "default": "./quantify.hardware.json",
              "required": false,
              "example": "./quantify.hardware.json"
            },
            {
              "key": "quantify_device_config",
              "help": "Path to the quantify device configuration YAML.",
              "type": "Path",
              "default": "./quantify.device.yml",
              "required": false,
              "example": "./quantify.device.yml"
            }
          ]
        },
